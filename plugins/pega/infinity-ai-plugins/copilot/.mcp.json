{
  "mcpServers": {
    "pega-infinity-authoring": {
      "tools": [
        "*"
      ],
      "command": "java",
      "args": [
        "-Dlogging.file.name=${user.home}/.infinity-rules-mcp/logs/infinity-rules-mcp.log",
        "-jar",
        "${PLUGIN_ROOT}/resources/infinity-rules-mcp.jar",
        "--spring.profiles.active=stdio"
      ],
      "env": {
        "PEGA_SKILLS_PATH": "${PLUGIN_ROOT}/resources",
        "PEGA_CLIENT_MODE": "copilot-plugin"
      }
    }
  }
}
