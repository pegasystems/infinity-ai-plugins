{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skills/rules-rule-obj-model/schema/rule-obj-model.json",
  "title": "Rule-Obj-Model",
  "description": "JSON schema for creating or updating a Pega Data Transform rule (Rule-Obj-Model). Fields marked x-pega-autoFill are injected by the builder and may be omitted from payloads.",
  "type": "object",
  "required": [
    "pxObjClass",
    "pyRuleName",
    "pyModelName",
    "pyLabel",
    "pyClassName"
  ],
  "properties": {
    "pxObjClass": {
      "type": "string",
      "const": "Rule-Obj-Model",
      "description": "Rule type class — always 'Rule-Obj-Model'.",
      "x-pega-autoFill": "Rule-Obj-Model",
      "x-pega-autoDerived": true
    },
    "pyModelName": {
      "type": "string",
      "description": "Internal name of the data transform (PascalCase or camelCase, no spaces)."
    },
    "pyRuleName": {
      "type": "string",
      "description": "Internal rule name. Auto-derived from pyModelName, the sole class key other than pyClassName. Do not set directly.",
      "x-pega-autoDerived": true,
      "x-pega-deriveFrom": "pyModelName"
    },
    "pyLabel": {
      "type": "string",
      "description": "Human-readable display label."
    },
    "pyClassName": {
      "type": "string",
      "description": "The Pega class this data transform applies to (e.g., 'MyOrg-MyApp-Work-MyCase')."
    },
    "pyDescription": {
      "type": "string",
      "description": "Developer-facing description of the data transform's purpose."
    },
    "pyDataModelFormat": {
      "type": "string",
      "enum": ["Clipboard", "JSON"],
      "description": "Format type — 'Clipboard' (standard mapping) or 'JSON' (JSON serialization/deserialization). Determines which body field is used.",
      "x-pega-autoFill": "Clipboard"
    },
    "pyCallSuperClassModel": {
      "type": "string",
      "description": "When 'true', Pega also executes the parent class's Data Transform of the same name (inheritance chaining).",
      "x-pega-autoFill": "false"
    },
    "pyRuleSet": {
      "type": "string",
      "description": "Rule set the data transform is saved to."
    },
    "pyRuleSetVersion": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{2}$",
      "description": "Rule set version (e.g., '01-01-01')."
    },
    "pyRuleAvailable": {
      "type": "string",
      "enum": ["Yes", "No", "Withdrawn", "Final", "Blocked"],
      "description": "Availability status.",
      "x-pega-autoFill": "Yes"
    },
    "pxLimitedAccess": {
      "type": "string",
      "enum": ["Dev", "Prod"],
      "description": "Access restriction: 'Dev' = developer only, 'Prod' = production-accessible."
    },
    "pyUsage": {
      "type": "string",
      "description": "Extended free-text notes (may contain newlines; shown in the Data Transform editor)."
    },
    "pyDateFormat": {
      "type": "string",
      "enum": ["Pega", "Default"],
      "description": "Date format for Data Transform date and time values."
    },
    "pyMemo": {
      "type": "string",
      "description": "Optional developer memo or change note for the Data Transform."
    },
    "pyRuleStatusReason": {
      "type": "string",
      "description": "Optional reason associated with the rule availability status. The server preserves this value when availability changes unless it is explicitly updated or cleared."
    },
    "pzInsKey": {
      "type": "string",
      "description": "Optional instance key identifying an existing Data Transform for update operations."
    },
    "pyProperties": {
      "type": "array",
      "description": "Clipboard format only. Ordered mapping steps (Embed-ModelParams). For JSON format, this must be an empty array.",
      "items": { "$ref": "#/$defs/ModelStep" },
      "x-pega-autoFill": []
    },
    "pyMappingModel": {
      "$ref": "#/$defs/MappingModel",
      "description": "JSON format only. Nested Rule-Obj-Mapping-JSON object defining the JSON field mappings."
    },
    "pyParameters": {
      "type": "array",
      "description": "Declared input/output parameters. Required for JSON DTs (jsonData + executionMode); optional for Clipboard DTs.",
      "items": { "$ref": "#/$defs/MethodParam" }
    },
    "pyPagesAndClasses": {
      "type": "array",
      "description": "Named pages used by this data transform, with their classes. Effectively required for Array-format JSON DTs with explicit (non-automap) pyProperties — see model-json-data-transforms, 'Array top-level with explicit (non-automap) property mappings'.",
      "items": { "$ref": "#/$defs/PageAndClass" }
    },
