    "pzRAApplication": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRAAppliesTo": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRABranchSelection": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRARecordConfiguration": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRARecordContext": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRARulePrefix": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzReindex": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormErrorHeader": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormKeysAndDescription": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormRuleset": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormStatus": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormToolbar": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormToolbarCheckin": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormToolbarCheckout": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormToolbarDelete": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormToolbarHotKeys": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormToolbarLockedIcon": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormToolbarSave": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormToolbarSaveAs": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleFormWarningsHeader": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleLockedInfoCheckedOut": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleLockedInfoCheckout": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleLockedInfoSaveAs": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleSetVersionMajor": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleSetVersionMinor": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzRuleSetVersionPatch": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzStatus": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzTenantID": { "$ref": "#/$defs/LegacyReadbackField" },
    "pzUnjustifiedWarningList": { "$ref": "#/$defs/LegacyReadbackField" },
    "tzActions": { "$ref": "#/$defs/LegacyReadbackField" }
  },
  "additionalProperties": false,
  "$defs": {
    "LegacyReadbackField": true,
    "ModelStep": {
      "type": "object",
      "description": "A single step in the data transform (Embed-ModelParams). Steps can be nested via pyProperties.",
      "required": ["pxObjClass", "pyActionName"],
      "properties": {
        "pxObjClass": {
          "type": "string",
          "const": "Embed-ModelParams",
          "description": "Always 'Embed-ModelParams'.",
          "x-pega-autoFill": "Embed-ModelParams",
          "x-pega-autoDerived": true
        },
        "pyActionName": {
          "type": "string",
          "enum": ["SET", "UPDATE_PAGE", "APPEND_AND_MAP_TO", "APPEND_TO", "WHEN", "OTHERWISE_WHEN", "OTHERWISE", "EXIT_MODEL", "EXIT_FOR_EACH", "FOR_EACH_PAGE_IN", "APPLY_MODEL", "REMOVE", "SORT", "COMMENT"],
          "description": "Action type for this step."
        },
        "pyPropertiesName": {
          "type": "string",
          "description": "Target property path, page reference, condition expression, Data Transform name, or comment text — meaning depends on pyActionName."
        },
        "pyPropertiesValue": {
          "type": "string",
          "description": "Value expression or source reference — meaning depends on pyActionName. Empty for most structural actions.",
          "x-pega-autoFill": ""
        },
        "pyProperties": {
          "type": "array",
          "description": "Child steps. Used by structural actions (UPDATE_PAGE, APPEND_AND_MAP_TO, APPEND_TO, WHEN, OTHERWISE_WHEN, OTHERWISE, FOR_EACH_PAGE_IN); empty array for leaf actions (SET, EXIT_MODEL, EXIT_FOR_EACH, REMOVE, COMMENT, APPLY_MODEL, SORT).",
          "items": { "$ref": "#/$defs/ModelStep" },
          "x-pega-autoFill": []
        },
        "pyDisabled": {
          "type": "string",
          "description": "When 'true', the step is skipped at runtime.",
          "x-pega-autoFill": "false"
        },
        "pyRelationNameUpdatepage": {
          "type": "string",
          "enum": ["BLANK", "WITH_VALUES_FROM", ""],
          "description": "UPDATE_PAGE only. 'BLANK' = clear the page before applying child SET steps; 'WITH_VALUES_FROM' = copy all properties from a source page; '' = update in place. See this SKILL.md's 'UPDATE_PAGE — WITH_VALUES_FROM' for the exact mechanics."
        },
        "pyRelationNameAppend": {
          "type": "string",
          "enum": ["NEW_PAGE", "EXISTING_PAGE", "CURRENT_SOURCE_PAGE", "EXISTING_PAGE_LIST"],
          "description": "APPEND_AND_MAP_TO / APPEND_TO / FOR_EACH_PAGE_IN. Determines the source of pages — not every mode is valid on every action. See this SKILL.md's 'pyRelationNameAppend — modes per action' for the full per-action breakdown."
        },
        "pyRelationNameWhen": {
          "type": "string",
          "description": "When rule name for step-level condition. Step is skipped if the When rule evaluates false. Distinct from WHEN action type."
        },
        "pyUpdateSourceContext": {
          "type": "string",
          "enum": ["true", "false"],
          "description": "FOR_EACH_PAGE_IN only. 'true' = property refs resolve against each iterated page. 'false' or omitted = refs resolve against the primary page. Optional — the server accepts FOR_EACH_PAGE_IN steps without this field."
        },
        "pyUpdateContextOptions": {
          "type": "string",
          "enum": ["JSON", "CLIPBOARD", ""],
          "description": "UPDATE_PAGE / APPEND_AND_MAP_TO only. Controls which context (JSON vs clipboard) advances when descending into a nested JSON node. Dotted-path expressions in pyPropertiesValue are silently skipped at runtime — descend one level per step instead. See model-json-data-transforms, 'UPDATE_PAGE — Navigate into nested JSON objects'."
        },
        "pyAppendAndMapToOptions": {
          "type": "string",
          "enum": ["", "SCALARS", "ARRAYS", "PAGEGROUPS"],
          "description": "APPEND_AND_MAP_TO only. Element type in the source JSON array. See model-json-data-transforms, 'APPEND_AND_MAP_TO — Map JSON arrays to Page Lists' for the full value table and the JSON-DT-specific MappingStep field this is not to be confused with."
        },
        "pyClassName": {
          "type": "string",
          "description": "APPLY_MODEL: class to resolve the called data transform. APPEND_TO: optional class context for the appended page (usually empty)."
        },
        "pyModelName": {
          "type": "string",
          "description": "APPLY_MODEL only. Name of the called data transform."
        },
        "pyPassCurrentParameterPage": {
          "type": "string",
          "description": "APPLY_MODEL only. 'true' = pass current parameter page through, 'false' = build new from step's pyParameters."
        },
        "pyParameters": {
          "type": "array",
          "description": "APPLY_MODEL only. Parameter values to pass to the called data transform.",
          "items": { "$ref": "#/$defs/MethodParam" }
        },
        "pyAppendActionWhenProp": {
          "type": "string",
          "description": "APPEND_AND_MAP_TO / APPEND_TO. Property condition for conditional append. When set, the append is only executed if the condition evaluates to true. Usually empty."
        },
        "pySortActionPropList": {
          "type": "array",
          "description": "SORT only. List of sort criteria applied in order. Each entry specifies a property and direction.",
          "items": { "$ref": "#/$defs/ModelSortParam" }
        },
        "pyExpanded": {
          "type": "string",
          "description": "UI expansion state — cosmetic only."
        },
        "pyPropertyStepId": {
          "type": "string",
          "description": "Hierarchical step identifier used for Data Transform step ordering."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "pyActionName": { "const": "SET" } },
            "required": ["pyActionName"]
          },
          "then": { "required": ["pyPropertiesName", "pyPropertiesValue"] }
        },
        {
          "if": {
            "properties": { "pyActionName": { "enum": ["UPDATE_PAGE", "APPEND_AND_MAP_TO", "WHEN", "OTHERWISE_WHEN", "FOR_EACH_PAGE_IN"] } },
            "required": ["pyActionName"]
          },
          "then": { "required": ["pyPropertiesName", "pyProperties"] }
        },
        {
          "if": {
            "properties": { "pyActionName": { "const": "OTHERWISE" } },
            "required": ["pyActionName"]
          },
          "then": { "required": ["pyProperties"] }
        },
        {
          "if": {
            "properties": { "pyActionName": { "enum": ["REMOVE", "COMMENT"] } },
            "required": ["pyActionName"]
          },
          "then": { "required": ["pyPropertiesName"] }
        },
        {
          "if": {
            "properties": { "pyActionName": { "const": "UPDATE_PAGE" } },
            "required": ["pyActionName"]
          },
          "then": { "required": ["pyRelationNameUpdatepage"] }
        },
        {
          "if": {
            "properties": { "pyActionName": { "const": "APPEND_AND_MAP_TO" } },
            "required": ["pyActionName"]
          },
          "then": { "required": ["pyRelationNameAppend"] }
        },
        {
          "if": {
            "properties": { "pyActionName": { "const": "APPLY_MODEL" } },
            "required": ["pyActionName"]
          },
          "then": { "required": ["pyPropertiesName", "pyModelName", "pyClassName", "pyPassCurrentParameterPage"] }
        },
        {
          "if": {
            "properties": { "pyActionName": { "const": "SORT" } },
            "required": ["pyActionName"]
          },
          "then": { "required": ["pyPropertiesName", "pySortActionPropList"] }
        },
        {
          "if": {
            "properties": { "pyActionName": { "const": "APPEND_TO" } },
            "required": ["pyActionName"]
          },
          "then": { "required": ["pyPropertiesName", "pyRelationNameAppend"] }
        }
      ],
      "additionalProperties": false
    },
    "MethodParam": {
      "type": "object",
      "description": "A parameter entry (Embed-MethodParams). Used for both rule-level parameter definitions and APPLY_MODEL step-level parameter values.",
      "properties": {
        "pxObjClass": {
          "type": "string",
          "const": "Embed-MethodParams",
          "x-pega-autoFill": "Embed-MethodParams",
          "x-pega-autoDerived": true
        },
        "pyParametersParamName": {
          "type": "string",
          "description": "Parameter name."
        },
        "pyParametersParamDesc": {
          "type": "string",
          "description": "Description."
        },
        "pyParametersParamType": {
          "type": "string",
          "enum": ["STRING", "PAGE", "Page List", "TrueFalse", "INTEGER", "Decimal", "Date", "DateTime"],
          "description": "Data type."
        },
        "pyParametersParamInOut": {
          "type": "string",
          "enum": ["IN", "OUT", "INOUT"],
          "description": "Direction."
        },
        "pyParametersParamReq": {
          "type": "string",
          "enum": ["0", "-1"],
          "description": "Required: '0' = optional, '-1' = required."
        },
        "pyParametersParamDefaultValue": {
          "type": "string",
          "description": "Default value expression (fallback only — NOT used for explicit parameter passing in APPLY_MODEL steps)."
        },
        "pyParametersParamValue": {
          "type": "string",
          "description": "APPLY_MODEL step-level only. Runtime value expression passed to the called Data Transform. Required parameters are validated against this field."
        }
      },
      "additionalProperties": false
    },
    "PageAndClass": {
      "type": "object",
      "description": "A named page declaration (Embed-PagesAndClasses).",
      "properties": {
        "pxObjClass": {
          "type": "string",
          "const": "Embed-PagesAndClasses",
          "x-pega-autoFill": "Embed-PagesAndClasses",
          "x-pega-autoDerived": true
        },
        "pyPagesAndClassesPage": {
          "type": "string",
          "description": "Clipboard page name."
        },
        "pyPagesAndClassesClass": {
          "type": "string",
          "description": "Class of the page."
        },
        "pyPagesAndClassesMode": {
          "type": "string",
          "description": "Page mode (usually blank)."
        }
      },
      "additionalProperties": false
    },
    "ModelSortParam": {
      "type": "object",
      "description": "A sort criterion (Embed-ModelSortParams). Specifies a property and direction for SORT steps.",
      "required": ["pxObjClass", "pySortActionProp", "pyRelationNameSort"],
      "properties": {
        "pxObjClass": {
          "type": "string",
          "const": "Embed-ModelSortParams",
          "x-pega-autoFill": "Embed-ModelSortParams",
          "x-pega-autoDerived": true
        },
        "pySortActionProp": {
          "type": "string",
          "description": "Property to sort by (dot-prefixed relative to the page list, e.g. '.pySeverity')."
        },
        "pyRelationNameSort": {
          "type": "string",
          "enum": ["ASCENDING", "DESCENDING"],
          "description": "Sort direction."
        }
      },
      "additionalProperties": false
    },
    "MappingModel": {
      "type": "object",
      "description": "JSON format body (Rule-Obj-Mapping-JSON). Used when pyDataModelFormat is 'JSON'.",
      "properties": {
        "pxObjClass": {
          "type": "string",
          "const": "Rule-Obj-Mapping-JSON",
          "x-pega-autoFill": "Rule-Obj-Mapping-JSON",
          "x-pega-autoDerived": true
        },
        "pyClassName": {
          "type": "string",
          "description": "Class context for JSON mapping. For Array top-level with explicit pyProperties, must equal the outer rule's own pyClassName (typically 'Code-Pega-List'), not the entity class. For Object top-level, set to the entity class. See model-json-data-transforms, 'Top-level element structure' and 'Array top-level with explicit (non-automap) property mappings'."
        },
        "pyPageClass": {
          "type": "string",
          "description": "For Array top-level with explicit pyProperties, OMIT entirely — setting any value causes an unresolved '$CLASS' that fails create-rule or silently no-ops at runtime. For Object top-level, set to the entity class. See model-json-data-transforms, 'Array top-level with explicit (non-automap) property mappings'."
        },
        "pyTopLevelElement": {
          "type": "string",
          "enum": ["Object", "Array"],
          "description": "Root JSON element type. 'Object' = root is a JSON object; 'Array' = root is a JSON array (requires pyArrayElements and pyListProperty)."
        },
        "pyArrayElements": {
          "type": "string",
          "enum": ["Objects", "Scalars", "Arrays"],
          "description": "Array only. Element type in the root JSON array. 'Objects' = array of objects; 'Scalars' = array of primitive values. Defaults to 'Objects' when pyTopLevelElement is 'Array' and omitted."
        },
        "pyListProperty": {
          "type": "string",
          "description": "Array only. Page list property that receives the array elements (e.g. '.pxResults')."
        },
        "pyDateFormat": {
          "type": "string",
          "enum": ["Pega", "Default"],
          "description": "Date format for date/time values in JSON. Required — empty string causes runtime IllegalArgumentException in ClipboardJSONMapAssembler.handleSettings. 'Pega' = Pega internal format (default); 'Default' = platform default format.",
          "x-pega-autoFill": "Pega"
        },
        "pyAutomapAll": {
          "type": "string",
          "description": "Auto-map all JSON fields to matching properties."
        },
        "pyCreateMultiDimArrays": {
          "type": "string",
          "description": "Whether to create multi-dimensional arrays."
        },
        "hiddenMappingsWarningAdded": {
          "type": "string",
          "const": "false",
          "description": "UI state field — must be 'false'."
        },
        "pyPropertiesName": {
          "type": "string",
          "description": "Root property name (empty for root mapping)."
        },
        "pyPageRef": {
          "type": "string",
          "description": "Root page ref (empty for root mapping)."
        },
        "pyProperties": {
          "type": "array",
          "description": "Field-level mapping definitions (Embed-MappingParams).",
          "items": { "$ref": "#/$defs/MappingStep" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "pyTopLevelElement": { "const": "Array" } },
            "required": ["pyTopLevelElement"]
          },
          "then": { "required": ["pyArrayElements", "pyListProperty"] }
        },
        {
          "if": {
            "properties": { "pyTopLevelElement": { "const": "Object" } },
            "required": ["pyTopLevelElement"]
          },
          "then": {
            "not": { "required": ["pyArrayElements"] },
            "properties": {
              "pyArrayElements": false,
              "pyListProperty": false
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "MappingStep": {
      "type": "object",
      "description": "A JSON mapping entry (Embed-MappingParams).",
      "properties": {
        "pxObjClass": {
          "type": "string",
          "const": "Embed-MappingParams",
          "x-pega-autoFill": "Embed-MappingParams",
          "x-pega-autoDerived": true
        },
        "pyActionName": {
          "type": "string",
          "enum": ["SET", "AUTO_MAP", "UPDATE_PAGE", "APPEND_AND_MAP_TO", "APPLY_DATA_TRANSFORM", "COMMENT"],
          "description": "Mapping action type."
        },
        "pyElementType": {
          "type": "string",
          "description": "'Objects' for object/array context. Case-sensitive — use 'Objects' (not 'OBJECTS')."
        },
        "pyPageClass": {
          "type": "string",
          "description": "Class context for the property. On parent steps (SET, UPDATE_PAGE, APPEND_AND_MAP_TO): the parent entity class. On child SETs inside APPEND_AND_MAP_TO: the page list entry class."
        },
        "pyPropertiesName": {
          "type": "string",
          "description": "Target clipboard property path (e.g. '.Email'). Empty string for UPDATE_PAGE with 'No context change' (For JSON only)."
        },
        "pyPropertiesValue": {
          "type": "string",
          "description": "Source JSON key name. Must be a single key — NOT a dotted path. Use UPDATE_PAGE to descend into nested objects."
        },
        "pyPageRef": {
          "type": "string",
          "description": "Page reference context. Empty at top level. Inside APPEND_AND_MAP_TO children: the page list property name (e.g. '.Accommodations')."
        },
        "pyUpdateContextOptions": {
          "type": "string",
          "enum": ["JSON", "CLIPBOARD", ""],
          "description": "UPDATE_PAGE only. 'JSON' = For JSON only (JSON context descends, clipboard stays flat — most common). 'CLIPBOARD' = For clipboard only. '' = For both sides (default). Controls which side descends when navigating nested structures."
        },
        "pyAppendAndMapToOptions": {
          "type": "string",
          "enum": ["", "SCALARS", "ARRAYS", "PAGEGROUPS"],
          "description": "APPEND_AND_MAP_TO only. Element type in the JSON array. '' (empty/default) = An array of objects — the standard pattern for API responses. 'SCALARS' = An array of scalars. 'ARRAYS' = An array of arrays. 'PAGEGROUPS' = A group of pages (edge case)."
        },
        "pyPropertyStepId": {
          "type": "string",
          "description": "Hierarchical step identifier (e.g. '1', '2', '7', '7.1', '7.2'). Assigned automatically by the UI; include when creating via API for consistent ordering."
        },
        "pyDisabled": {
          "type": "string",
          "description": "When 'true', this mapping entry is skipped at runtime."
        },
        "pyExpanded": {
          "type": "string",
          "description": "UI expansion state for steps with children — 'true' shows children expanded. Cosmetic only, no runtime effect."
        },
        "pyEmptyBehavior": {
          "type": "string",
          "enum": ["", "SKIP", "SET_DEFAULT"],
          "description": "Behavior when the JSON value is empty/null. '' (empty/default) = 'Default value' in UI — uses property's default. 'SKIP' = leave clipboard property unchanged. 'SET_DEFAULT' = explicitly set to default value."
        },
        "pySkippedProperties": {
          "type": "string",
          "description": "UPDATE_PAGE / APPEND_AND_MAP_TO. Comma-separated list of properties to skip during mapping. Usually empty."
        },
        "hiddenMappingsWarningAdded": {
          "type": "string",
          "const": "false",
          "description": "UI state field — must be 'false'. Required on UPDATE_PAGE and APPEND_AND_MAP_TO steps."
        },
        "pyProperties": {
          "type": "array",
          "description": "Child mapping entries for nested objects/arrays. Used by UPDATE_PAGE (sub-mappings within the descended context) and APPEND_AND_MAP_TO (mappings for each array element). Empty array [] for leaf SET/COMMENT steps.",
          "items": { "$ref": "#/$defs/MappingStep" }
        }
      },
      "additionalProperties": false
    }
  }
}
