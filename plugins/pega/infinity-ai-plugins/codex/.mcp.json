{
  "pega-infinity-authoring": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "--package=@pega/infinity-authoring-plugin@0.2.1",
      "infinity-authoring-plugin",
      "run-server"
    ],
    "cwd": "./",
    "env_vars": [
      "PEGA_BASE_URL",
      "PEGA_OAUTH_CLIENT_ID",
      "PEGA_INFINITY_VERSION",
      "PEGA_OAUTH_REDIRECT_PORT"
    ],
    "startup_timeout_sec": 20,
    "tool_timeout_sec": 120
  }
}
