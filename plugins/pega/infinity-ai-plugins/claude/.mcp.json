{
  "mcpServers": {
    "Pega Infinity Authoring": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@pega/infinity-authoring-plugin@0.2.1",
        "infinity-authoring-plugin",
        "run-server"
      ],
      "env": {
        "PEGA_BASE_URL": "${user_config.pega_base_url}",
        "PEGA_OAUTH_CLIENT_ID": "${user_config.pega_oauth_client_id}"
      }
    }
  }
}
